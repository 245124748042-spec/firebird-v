# Copy this file to .env and edit. Raspberry Pi mode never opens the laptop serial port.
RASPBERRY_PI_MODE=true
SERIAL_PORT=
BAUD_RATE=9600
HOST=0.0.0.0
PORT=8000
MODEL_PATH=models/firebird_person_yolov8n_best.pt
CAMERA_INDEX=0
CONFIDENCE_THRESHOLD=0.60
PERSON_COUNT_STABLE_FRAMES=3
SIMULATION_TICK_MS=200
MAP_ROWS=10
MAP_COLUMNS=10
# Encoder odometry stays disabled until all four measured values are set.
# WHEEL_DIAMETER_M=<measured metres>
# WHEEL_TRACK_M=<measured metres>
# ENCODER_PULSES_PER_REVOLUTION=<measured pulses per wheel revolution>
# MAP_CELL_SIZE_M=<physical metres per map cell>
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
